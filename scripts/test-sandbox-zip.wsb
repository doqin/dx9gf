<Configuration>
  <!-- End-to-end test of the real distribution artifact: the runner
       (run-sandbox-zip-test.cmd) extracts dist\DX9GF-Demo.zip inside the
       sandbox like a player would, runs the game from a local path, and
       copies any demo.exe.crash.log back to the mapped dist folder. -->
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\repos\doqin\dx9gf\dist</HostFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>D:\repos\doqin\dx9gf\scripts</HostFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <VGpu>Enable</VGpu>
  <AudioOutput>Enable</AudioOutput>
  <LogonCommand>
    <Command>C:\Users\WDAGUtilityAccount\Desktop\scripts\run-sandbox-zip-test.cmd</Command>
  </LogonCommand>
</Configuration>
